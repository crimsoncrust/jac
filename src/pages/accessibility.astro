---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Accessibility | JAC Surface Coatings"
  description="Accessibility statement for JAC Surface Coatings & Solutions website."
>
  <section class="page-hero" style="padding-bottom: var(--space-md);">
    <div class="container page-hero__inner">
      <h1 class="page-hero__title">Accessibility</h1>
    </div>
  </section>

  <section class="section section-light">
    <div class="container-narrow">
      <div style="color: var(--color-text-dark-secondary); line-height: 1.8;">
        <p>JAC Surface Coatings is committed to making this website accessible to all users. If you experience difficulty using any portion of this website due to a disability, please contact us:</p>
        <ul style="list-style: disc; padding-left: 1.5rem; margin-top: 1rem; display: flex; flex-direction: column; gap: 0.5rem;">
          <li>Phone / Text: <a href="tel:8179811400" style="color: var(--color-gold);">817-981-1400</a></li>
          <li>Quote form: <a href="/quote" style="color: var(--color-gold);">jacsurfacecoatings.com/quote</a></li>
        </ul>
        <p style="margin-top: 1.5rem;">We will work to provide information in an alternative format and address any accessibility barriers identified.</p>
      </div>
    </div>
  </section>
</BaseLayout>
