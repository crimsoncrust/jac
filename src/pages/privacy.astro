---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy | JAC Surface Coatings"
  description="Privacy policy for JAC Surface Coatings & Solutions."
>
  <section class="page-hero" style="padding-bottom: var(--space-md);">
    <div class="container page-hero__inner">
      <h1 class="page-hero__title">Privacy Policy</h1>
      <p class="page-hero__sub">Last updated: [DATE — update before launch]</p>
    </div>
  </section>

  <section class="section section-light">
    <div class="container-narrow">
      <div style="color: var(--color-text-dark-secondary); line-height: 1.8;">
        <p><strong style="color: var(--color-text-dark);">Privacy Policy Placeholder</strong></p>
        <p style="margin-top: 1rem;">This page is a placeholder. Replace with a complete privacy policy before launching the website. The privacy policy should address:</p>
        <ul style="list-style: disc; padding-left: 1.5rem; margin-top: 1rem; display: flex; flex-direction: column; gap: 0.5rem;">
          <li>What information is collected through the quote form and website</li>
          <li>How that information is used (follow-up communications)</li>
          <li>Whether information is shared with third parties</li>
          <li>Cookie and analytics usage</li>
          <li>Contact information for privacy inquiries</li>
          <li>Texas-specific consumer privacy disclosures if applicable</li>
        </ul>
        <p style="margin-top: 1.5rem;">Contact: <a href="tel:8179811400" style="color: var(--color-gold);">817-981-1400</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
